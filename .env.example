# Whop — pagamentos (cartão + PIX) do checkout /checkout
# Chave da API (Whop → Developer → API keys). Permissões: payment:charge, payment:basic:read,
# plan:create, criar/editar produto, webhook_receive:payments. NUNCA expor no navegador.
WHOP_API_KEY=
# ID da conta/empresa (biz_…). É público: vai para o navegador montar os campos.
WHOP_ACCOUNT_ID=
# Segredo do webhook (ws_…), mostrado UMA vez quando o webhook é criado.
# Endpoint: https://tabua.titanchefcut.com/api/whop/webhook
WHOP_WEBHOOK_SECRET=
# Opcional: "sandbox" para testar no sandbox da Whop.
WHOP_ENVIRONMENT=
# Opcional: restringe os métodos (ex.: card,pix). Vazio = a configuração da conta Whop decide.
WHOP_PAYMENT_METHODS=
# URL pública do site (usada no return_url da Whop).
NEXT_PUBLIC_SITE_URL=https://tabua.titanchefcut.com
